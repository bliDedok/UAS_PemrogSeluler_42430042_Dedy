<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_premium"
    android:elevation="7dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/imgIoT"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_image_premium"
        android:contentDescription="Gambar perangkat IoT"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/esp32" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESP32"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_badge_premium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Mikrokontroler"
            android:textColor="#0369A1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemFunction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Mengontrol sistem IoT dan koneksi WiFi"
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>